#include <windows.h>

// Per-monitor DPI awareness and modern controls come from the manifest.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "glance.manifest"

// The app icon (drawn by scripts/make-icons.ps1). The first icon resource is the one Explorer shows.
1 ICON "glance.ico"
// File icons for Glance's file types (FileTypes.h): pictures, PDFs and videos.
2 ICON "picture.ico"
3 ICON "pdf.ico"
4 ICON "video.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Glance image viewer"
            VALUE "ProductName", "Glance"
            VALUE "FileVersion", "0.4.0"
            VALUE "ProductVersion", "0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
