#include <windows.h>

// Per-monitor DPI awareness and modern controls come from the manifest.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "glance.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Glance image viewer"
            VALUE "ProductName", "Glance"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
